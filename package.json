{
  "name": "shortener-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env-file .env.prod",
    "deploy": "npm run -s deploy:secrets && wrangler deploy",
    "deploy:secrets": "grep -E '^(SECRET_KEY|API_KEY)=' .env.prod | tr -d '\\r' > /tmp/shortener-secrets.env && npx wrangler secret bulk --name shortener /tmp/shortener-secrets.env && rm /tmp/shortener-secrets.env",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "hono": "^4.13.5",
    "jose": "^6.2.10"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.9.0",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@nodecraft/eslint-config": "^51.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "eslint-plugin-import-newlines": "^2.0.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-regexp": "^3.2.0",
    "eslint-plugin-unicorn": "^73.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.2.7",
    "wrangler": "4.44.0"
  }
}
